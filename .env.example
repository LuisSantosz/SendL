# Copie este arquivo para .env. Não envie o .env ao GitHub.
PORT=3000
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
# No Railway: NODE_ENV=production, APP_ORIGIN=https://SEU-SERVICO.up.railway.app
# Use TRUST_PROXY=1 apenas atrás do proxy confiável do Railway.
TRUST_PROXY=0

# Acesso ao painel (independente da conta Gmail)
ADMIN_EMAIL=
# Escolha uma senha forte com pelo menos 12 caracteres.
ADMIN_PASSWORD=

# Google OAuth: aplicativo do tipo Web com Gmail API habilitada
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/gmail/callback
GMAIL_EMAIL=faturamentoedelwhite@gmail.com

# Produção: caminho do volume persistente, por exemplo /data.
# Tokens Gmail e comprovantes de envio ficam fora da pasta pública.
DATA_DIR=./data
